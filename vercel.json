{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/news",
      "destination": "/api/feeds?r=news"
    },
    {
      "source": "/api/sentiment",
      "destination": "/api/feeds?r=sentiment"
    },
    {
      "source": "/api/cryptocats",
      "destination": "/api/feeds?r=cryptocats"
    },
    {
      "source": "/api/econ",
      "destination": "/api/feeds?r=econ"
    },
    {
      "source": "/api/dividends",
      "destination": "/api/feeds?r=dividends"
    },
    {
      "source": "/api/calendar",
      "destination": "/api/feeds?r=calendar"
    },
    {
      "source": "/api/macro",
      "destination": "/api/feeds?r=macro"
    },
    {
      "source": "/api/search",
      "destination": "/api/feeds?r=search"
    },
    {
      "source": "/api/quote",
      "destination": "/api/feeds?r=quote"
    },
    {
      "source": "/api/rates",
      "destination": "/api/feeds?r=rates"
    },
    {
      "source": "/api/events",
      "destination": "/api/feeds?r=events"
    },
    {
      "source": "/api/btc",
      "destination": "/api/feeds?r=btc"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; frame-src https://s.tradingview.com https://www.tradingview-widget.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
