# Optionnel : clé "Demo" gratuite CoinGecko (https://www.coingecko.com/en/api)
# À définir dans Vercel > Project > Settings > Environment Variables, jamais dans le code.
COINGECKO_API_KEY=

# Optionnel : adresse de la fonction Supabase « alerts » (alertes de prix).
# Par défaut : https://glvxxxoxcxsxdnbofgqf.supabase.co/functions/v1/alerts (adresse publique, pas un secret).
# Aucun secret n'est nécessaire côté Vercel : les clés VAPID et le secret de la tâche planifiée sont dans Supabase Vault.
ALERTS_FUNCTION_URL=
